# Django Environment Configuration Example
SECRET_KEY=django-insecure-academic-paper-research-portal-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins (Frontend Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NVIDIA Nemotron 3 Ultra LLM Configuration
# Provide your NVIDIA API Key (e.g. nvapi-...) from https://build.nvidia.com
# If omitted or left blank, the system automatically uses the built-in
# high-precision academic NLP structuring engine (zero external API dependency required).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra
